{
  "manifest_version": 3,
  "name": "PassVault — Secure Password Manager",
  "version": "1.0.0",
  "description": "Securely detect, save, and autofill website login credentials with PassVault.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PassVault Password Manager"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
