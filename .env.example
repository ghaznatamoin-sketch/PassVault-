# PassVault Environment Variables Example
# Public Supabase credentials for Phase 2 integration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server-only secret encryption key (Phase 2)
# NEVER add NEXT_PUBLIC_ prefix to this key
ENCRYPTION_KEY=your-32-byte-hex-or-base64-secret-key-here
